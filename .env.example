TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWELVE_DATA_API_KEY=
SYMBOLS=XAU/USD,EUR/USD,GBP/USD
INTERVAL=5min
SCAN_INTERVAL_MS=300000
MIN_REWARD_RISK=2
SWING_LOOKBACK=10
STRUCTURE_LOOKBACK=5
MAX_CANDLE_AGE_MINUTES=20
MAX_STORED_SIGNAL_KEYS=1000
# Required on Vercel (Upstash Redis REST credentials)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional; defaults to sotra:<VERCEL_ENV>
# UPSTASH_STATE_PREFIX=sotra:production
TELEGRAM_WEBHOOK_SECRET=
# Required on Vercel; configure this same secret in cron-job.org's Authorization header
CRON_SECRET=
# Optional; local mode defaults to file, Vercel defaults to upstash
# STATE_BACKEND=file
# Local file mode only; defaults to data/state.json
# STATE_FILE=data/state.json
